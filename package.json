{
  "name": "amex-analysis-mcp",
  "version": "3.0.0",
  "description": "Local MCP server and CLI for American Express spending analysis with vendor unmasking",
  "main": "dist/amex-mcp-server.js",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "amex-analysis": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p amex-mcp-tsconfig.json",
    "build:enhanced": "tsc -p amex-mcp-tsconfig.json",
    "start": "node dist/amex-mcp-server.js",
    "start:enhanced": "node dist/amex-mcp-server-enhanced.js",
    "dev": "tsx amex-mcp-server.ts",
    "dev:basic": "AMEX_MCP_MODE=basic tsx amex-mcp-server.ts",
    "dev:enhanced": "tsx amex-mcp-server-enhanced.ts",
    "analyze": "tsx src/cli.ts analyze",
    "test": "tsx --test tests/*.test.ts",
    "test-unmasking": "tsx --test tests/unmasker.test.ts",
    "demo": "tsx test-analyzer.ts"
  },
  "exports": {
    ".": "./dist/amex-mcp-server.js",
    "./vendor-unmasker": "./dist/amex-vendor-unmasker.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "csv-writer": "^1.6.0",
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.3.14",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ogprotege/amex-anaylsis-mcp.git"
  },
  "license": "MIT"
}
